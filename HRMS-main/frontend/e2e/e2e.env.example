# Role-access E2E suite (e2e/, ../docker-compose.e2e.yml). Copy to frontend/.env.e2e (git-ignored) or export these variables.
# These are the SYNTHETIC demo accounts that scripts/seed.py creates inside the disposable E2E stack only (also listed
# in the README). Never put real or production credentials here. Missing values make the suite skip (NOT_TESTED).
E2E_WEB_URL=http://127.0.0.1:13000
E2E_API_URL=http://127.0.0.1:18000
E2E_ADMIN_EMAIL=admin@mock-hrms.dev
E2E_ADMIN_PASSWORD=password123
E2E_MANAGER_EMAIL=manager@mock-hrms.dev
E2E_MANAGER_PASSWORD=password123
E2E_EMPLOYEE_EMAIL=employee@mock-hrms.dev
E2E_EMPLOYEE_PASSWORD=password123
