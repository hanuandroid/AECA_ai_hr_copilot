APP_NAME=Mock HRMS API
ENVIRONMENT=dev
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite+aiosqlite:///./storage/hrms.db
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMPLOYEE_DOCUMENT_UPLOAD_DIR=/app/storage/employee-documents

# AI copilot (placeholders only - never commit real keys)
AI_ENABLED=true
# anthropic | openai | fake (tests only). Switching provider is configuration only; there is no automatic fallback.
AI_LLM_PROVIDER=anthropic
AI_LLM_MODEL=claude-sonnet-5-5
AI_LLM_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
# OpenAI (used only when AI_LLM_PROVIDER=openai). Choose a model available to your OpenAI project that supports
# Structured Outputs (JSON schema); there is no default. The fast (routing) model falls back to AI_OPENAI_MODEL.
OPENAI_API_KEY=
AI_OPENAI_MODEL=
AI_OPENAI_FAST_MODEL=
# AI_OPENAI_REASONING_EFFORT=
# AI_TEMPERATURE=            # leave unset: current Claude models reject non-default temperature
AI_MAX_TOKENS=4096
AI_LLM_EFFORT=low
AI_LLM_SERVER_FALLBACKS=true
AI_REQUEST_TIMEOUT_SECONDS=30
AI_EMBEDDING_PROVIDER=fastembed
AI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AI_EMBEDDING_CACHE_DIR=/app/storage/models
AI_SQL_MAX_ROWS=100
AI_SQL_MAX_JOINS=4
AI_SQL_TIMEOUT_SECONDS=3
AI_ACTION_CONFIRMATION_TTL_SECONDS=300
AI_CONVERSATION_MAX_MESSAGES=200
AI_AUDIT_ENABLED=true
# Dedicated HMAC key for audit text fingerprints (>= 32 chars, NOT the JWT secret). Required in production; empty in dev.
AI_AUDIT_FINGERPRINT_KEY=
# Optional: USD per million tokens, used only for ESTIMATED cost in audit events (leave empty -> cost null)
# AI_LLM_INPUT_COST_PER_MTOK=
# AI_LLM_OUTPUT_COST_PER_MTOK=
# AI_LLM_FAST_INPUT_COST_PER_MTOK=
# AI_LLM_FAST_OUTPUT_COST_PER_MTOK=
# OpenAI pricing (USD per million tokens) for ESTIMATED cost; never shared with Anthropic rates.
# AI_OPENAI_INPUT_COST_PER_MTOK=
# AI_OPENAI_OUTPUT_COST_PER_MTOK=
# AI_OPENAI_FAST_INPUT_COST_PER_MTOK=
# AI_OPENAI_FAST_OUTPUT_COST_PER_MTOK=
AI_CONVERSATION_CONTEXT_MESSAGES=6
AI_CONVERSATION_CONTEXT_CHARS=2000
AI_CONVERSATION_STORED_MESSAGE_CHARS=4000
AI_RAG_TOP_K=4
AI_RAG_MIN_SCORE=0.35
AI_POLICY_CHUNK_SIZE=800
AI_POLICY_CHUNK_OVERLAP=120
# G-11 password step-up: off | log | enforce. Default log (records refusals, never blocks); enforce is not approved.
# STEP_UP_ENFORCEMENT=log
