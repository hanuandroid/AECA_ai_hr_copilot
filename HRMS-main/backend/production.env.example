# Production environment template for docker-compose.prod.yml (production hardening Phase 2).
# Copy to a file OUTSIDE version control (e.g. backend/.env.production, git-ignored) and fill every empty value.
# Startup refuses unsafe values (app/core/production_checks.py). Never commit real secrets.

ENVIRONMENT=production
APP_TIMEZONE=Asia/Kolkata

# Secrets (>= 32 random characters each; the two keys must differ)
JWT_SECRET_KEY=
AI_AUDIT_FINGERPRINT_KEY=

# Exact public host name(s) of the API and the browser origin(s) of the web app (no wildcards)
ALLOWED_HOSTS=
CORS_ALLOW_ORIGINS=
# Reverse-proxy address(es) whose X-Forwarded-* headers uvicorn may trust
FORWARDED_ALLOW_IPS=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMPLOYEE_DOCUMENT_UPLOAD_DIR=/app/storage/employee-documents

# AI. Without an approved provider configuration set AI_ENABLED=false (the Copilot then reports AI_UNAVAILABLE).
AI_ENABLED=false
AI_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Or AI_LLM_PROVIDER=openai with OPENAI_API_KEY and AI_OPENAI_MODEL (only after the OpenAI data-processing decisions).
OPENAI_API_KEY=
AI_OPENAI_MODEL=
AI_EMBEDDING_PROVIDER=fastembed
AI_EMBEDDING_CACHE_DIR=/app/storage/models
# External tracing (LangSmith/LangChain) is refused unless explicitly approved
ALLOW_EXTERNAL_TRACING=false

# G-11 password step-up on high-impact admin operations (deployment-runbook.md §2.1).
# off | log | enforce (lower case). Approved value: log = check and record refusals, never block.
# enforce is NOT approved; switching needs explicit approval. Read once at startup: recreate the API container.
STEP_UP_ENFORCEMENT=log
